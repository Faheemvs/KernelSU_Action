CONFIG_ENV=config.env

# ============================================================ Kernel source ==
# Your fork of Mi-Thorium/kernel_msm-4.19 must have
# arch/arm64/configs/vendor/olive_defconfig on the mithorium/lineage-21 branch.
KERNEL_SOURCE=https://github.com/Faheemvs/kernel_msm-4.19
KERNEL_SOURCE_BRANCH=mithorium/lineage-21
KERNEL_CONFIG=vendor/olive_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64

KERNEL_NAME=Thorium-SuSFS
ADD_LOCALVERSION_TO_FILENAME=true

EXTRA_CMDS=LD=ld.lld KCFLAGS=-Wno-error=strict-prototypes
CUSTOM_CMDS=CLANG_TRIPLE=aarch64-linux-gnu-

# ================================================================ Toolchain ==
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_CUSTOM_CLANG=false
USE_LLVM=false
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
USE_CUSTOM_GCC_32=false

# ================================================================ KernelSU ==
KSU_VARIANT=sukisu-ultra
KSU_REF=builtin
KSU_HOOK_MODE=manual
ENABLE_KPM=false

# ==================================================================== SUSFS ==
ENABLE_SUSFS=true
SUSFS_REPO=https://github.com/Faheemvs/susfs4ksu.git
SUSFS_BRANCH=kernel-4.19

# path_umount is already inside the patched SUSFS patch, so keep this false
ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=true

# Clang 14 + old GNU assembler cannot handle DWARF5 debug info
EXTRA_DEFCONFIG=CONFIG_DEBUG_INFO=n

# ================================================================ Packaging ==
USE_CUSTOM_ANYKERNEL3=false
NEED_DTBO=false
BUILD_BOOT_IMG=false

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
