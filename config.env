name: Build Kernel
on:
  workflow_dispatch:

jobs:
  build-kernel:
    name: Build config.env
    runs-on: ubuntu-24.04
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Free Disk Space
        uses: jlumbroso/free-disk-space@main
        with:
          tool-cache: true
          android: false
          dotnet: true
          haskell: true
          large-packages: true
          docker-images: true
          swap-storage: false

      - name: Setup Configuration
        run: bash scripts/config.sh
        env:
          CONFIG_ENV: config.env

      - name: Download Toolchains
        run: bash scripts/toolchain.sh

      - name: Clone Kernel Source
        run: bash scripts/source.sh

      - name: Setup KernelSU
        run: bash scripts/kernelsu.sh

      - name: Apply Patches
        run: bash scripts/patches.sh all

      - name: Setup ccache
        uses: hendrikmuhs/ccache-action@v1.2
        with:
          key: kernel-build-ccache
          max-size: 2G

      - name: Patch KernelSU for Linux 4.19
        run: sed -i 's/MODULE_IMPORT_NS(.*);//g' kernel_workspace/android-kernel/drivers/kernelsu/ksu.c || true

      - name: Build Kernel
        run: bash scripts/build.sh all

      - name: Upload Kernel Image
        uses: actions/upload-artifact@v4
        with:
          name: Image.gz-dtb
          path: kernel_workspace/android-kernel/out/arch/arm64/boot/Image.gz-dtb
